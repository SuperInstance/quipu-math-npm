{
  "name": "quipu-math",
  "version": "1.0.3",
  "description": "Mathematics of Incan knotted cord (quipu) data structures for JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "guard": "node guard/check-publishable.mjs .",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm run guard"
  },
  "keywords": [
