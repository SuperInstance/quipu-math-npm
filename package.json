    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/SuperInstance/quipu-math-npm#readme",
  "bugs": {
    "url": "https://github.com/SuperInstance/quipu-math-npm/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
